# ==============================================================================
# EasyStore - Environment Configuration Template
# Web-Based Management Layer for S3-Compatible Object Storage
# Compatible with MinIO (Development) & Scality ARTESCA (Production)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 14+ with JSONB support)
# ------------------------------------------------------------------------------
POSTGRES_USER=madhavi
POSTGRES_PASSWORD=Madhavi123
POSTGRES_DB=artesca_metadata
DATABASE_URL=postgresql+psycopg://madhavi:Madhavi123@127.0.0.1:5432/artesca_metadata

# ------------------------------------------------------------------------------
# 2. S3 Storage Configuration
# ------------------------------------------------------------------------------
# OPTION A: Local Development with MinIO (Default Docker Compose setup)
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=artesca-documents
S3_REGION=us-east-1
S3_VERIFY_SSL=false
S3_ADDRESSING_STYLE=path
S3_SIGNATURE_VERSION=s3v4

# OPTION B: Enterprise Scality ARTESCA (Uncomment & configure for production)
# S3_ENDPOINT_URL=https://s3.artesca.yourorganization.internal
# S3_ACCESS_KEY_ID=YOUR_ARTESCA_IAM_ACCESS_KEY
# S3_SECRET_ACCESS_KEY=YOUR_ARTESCA_IAM_SECRET_KEY
# S3_BUCKET=artesca-documents
# S3_REGION=us-east-1
# S3_VERIFY_SSL=true
# S3_CA_BUNDLE=/path/to/enterprise-ca-bundle.pem
# S3_ADDRESSING_STYLE=path
# S3_SIGNATURE_VERSION=s3v4

# ------------------------------------------------------------------------------
# 3. Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=artesca-production-secret-replace-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ------------------------------------------------------------------------------
# 4. Host & Port Settings
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# 5. Frontend API Base URL (Used by Vite dev server)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
